# Copy to `.env` and fill in real values. Nothing in this file is a secret.
#
# Config is loaded by incident_agent/config/settings.py via pydantic-settings
# with env_nested_delimiter="__", e.g. ANTHROPIC__API_KEY maps to
# settings.anthropic.api_key.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Enterprise Incident Resolution Agent"
ENVIRONMENT=local            # local | development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                # true in staging/production for log-aggregator ingestion

CONFIDENCE_THRESHOLD=0.75      # below this, the graph replans instead of asking for human approval
MAX_REPLAN_ATTEMPTS=3

# ---------------------------------------------------------------------------
# LLM provider selection (Strategy pattern -- see services/llm_factory.py)
# ---------------------------------------------------------------------------
LLM__PRIMARY_PROVIDER=anthropic          # anthropic | openai | azure_openai
LLM__FALLBACK_PROVIDERS=["openai","azure_openai"]
LLM__TEMPERATURE=0.1
LLM__MAX_TOKENS=4096
LLM__REQUEST_TIMEOUT_SECONDS=60
LLM__MAX_RETRIES=2

# --- Anthropic (primary) ---
ANTHROPIC__API_KEY=sk-ant-your-key-here
ANTHROPIC__MODEL=claude-sonnet-5
ANTHROPIC__FALLBACK_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (fallback #1) ---
OPENAI__API_KEY=sk-your-key-here
OPENAI__MODEL=gpt-4.1

# --- Azure OpenAI (fallback #2) ---
AZURE_OPENAI__API_KEY=
AZURE_OPENAI__ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI__DEPLOYMENT=your-deployment-name
AZURE_OPENAI__API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Vector store (Chroma) / RAG
# ---------------------------------------------------------------------------
CHROMA__PERSIST_DIRECTORY=./data/chroma
CHROMA__COLLECTION_NAME=incident_knowledge_base
CHROMA__EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# LangGraph checkpointing / long-term memory (SQLite)
# ---------------------------------------------------------------------------
CHECKPOINT__DATABASE_PATH=./data/checkpoints/checkpoints.sqlite
MEMORY__DATABASE_PATH=./data/sqlite/memory.sqlite

# ---------------------------------------------------------------------------
# LangSmith observability
# ---------------------------------------------------------------------------
LANGSMITH__TRACING_ENABLED=false
LANGSMITH__API_KEY=
LANGSMITH__PROJECT=enterprise-incident-resolution-agent
LANGSMITH__ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# API transport
# ---------------------------------------------------------------------------
API__HOST=0.0.0.0
API__PORT=8000
API__CORS_ALLOW_ORIGINS=["*"]
API__API_KEY=
